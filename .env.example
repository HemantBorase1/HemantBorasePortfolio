# Web3Forms Access Key for contact form submissions
# Get yours for free at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Search Console ownership verification token.
# Found in GSC → Settings → Ownership verification → HTML tag method.
# Copy the content="" value (e.g. "abc123...") and paste it below.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
